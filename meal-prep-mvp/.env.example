# Local-first default
MODEL_PROVIDER=ollama
MODEL_ENABLED=true
MODEL_TIMEOUT_SECONDS=20

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Future hosted provider
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Meal Prep MVP

# Public application URL. Use the Vercel production URL after deployment.
APP_BASE_URL=http://localhost:8000

# Supabase Auth + PostgREST. The anon key is intentionally public; never add a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Keep false for local demo data. Set true in Vercel after Supabase OAuth is configured.
AUTH_REQUIRED=false
