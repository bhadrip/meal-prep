# Public application URL. Use the Vercel production URL after deployment.
APP_BASE_URL=http://localhost:8000

# Supabase Auth + PostgREST. The anon key is intentionally public; never add a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Keep false for local demo data. Set true in Vercel after Supabase OAuth is configured.
AUTH_REQUIRED=false
