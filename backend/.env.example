# Public application URL. Use the Vercel production URL after deployment.
APP_BASE_URL=http://localhost:8000

# Supabase Auth + PostgREST. The anon key is intentionally public.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only key for sending new-user invitations. Keep the value out of Git and browser code.
SUPABASE_SECRET_KEY=

# The dev-local.sh script sets this to true automatically. False is only for UI-only demo mode.
AUTH_REQUIRED=false
