# Public application URL. Use the Vercel production URL after deployment.
APP_BASE_URL=http://localhost:8000

# Supabase Auth + PostgREST. The anon key is intentionally public.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The dev-local.sh script sets this to true automatically. False is only for UI-only demo mode.
AUTH_REQUIRED=false

# Optional product analytics. Set POSTHOG_PROJECT_TOKEN in Vercel for production.
# The project token is intentionally public to the browser; never use a personal API key here.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
