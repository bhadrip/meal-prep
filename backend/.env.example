# Public application URL. Use the Vercel production URL after deployment.
APP_BASE_URL=http://localhost:8000

# Supabase Auth + PostgREST. The anon key is intentionally public; never add a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The dev-local.sh script sets this to true automatically. False is only for UI-only demo mode.
AUTH_REQUIRED=false
